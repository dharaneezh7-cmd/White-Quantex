# White Quantex v2 — Environment Variables
# Copy this to .env.local and fill in the values

# ─── Frontend ───────────────────────────────────────────────────────────────
# Vite dev proxy targets (used in vite.config.ts for local dev)
VITE_SPRING_API_URL=http://localhost:8080
VITE_NODE_API_URL=http://localhost:3001

# Base URLs for API clients (used in services)
VITE_SPRING_BASE_URL=/api/spring
VITE_NODE_BASE_URL=/api/node

# Public URL (for production builds)
VITE_PUBLIC_URL=http://localhost:7000
